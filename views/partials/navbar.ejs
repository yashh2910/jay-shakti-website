<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="<%= business.logo %>" alt="<%= business.name %> logo" class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name"><%= business.shortName %></span>
        <span class="brand-sub">Hardware &amp; Electronics</span>
      </span>
    </a>

    <nav class="main-nav" id="mainNav">
      <div class="main-nav-head">
        <span class="main-nav-title">Menu</span>
        <button class="nav-close" id="navClose" aria-label="Close navigation">&times;</button>
      </div>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/products" class="<%= currentPath.startsWith('/products') ? 'active' : '' %>">Products</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About Us</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
      <a href="/contact" class="btn btn-primary nav-cta" style="border-radius:12px 28px 12px 28px;">Send Enquiry</a>
    </nav>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-overlay" id="navOverlay"></div>
</header>
